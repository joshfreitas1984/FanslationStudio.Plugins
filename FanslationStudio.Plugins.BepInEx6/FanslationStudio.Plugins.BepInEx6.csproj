<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FanslationStudio.Plugins</AssemblyName>
    <PackageId>FanslationStudio.Plugins.BepInEx6</PackageId>
    <Authors>joshfreitas1984</Authors>
    <Description>Fanslation Studio Plugins for BepInEx 6 and Unity games</Description>
    <RepositoryUrl>https://github.com/joshfreitas1984/FanslationStudio.Plugins</RepositoryUrl>
    <Product>Plugins for BepinEx and Unity games</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>FanslationStudio.Plugins</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.753" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- BepInEx.Unity.Mono transitively pulls in the "UnityEngine" nuget package (a monolithic
         Unity 5.6.1 reference assembly), which duplicates the split-module engine types
         (GameObject, MonoBehaviour, TextAnchor, etc.) already provided by the Reference\*.dll
         assemblies below, causing CS0433 ambiguous-type errors. Excluding its compile assets
         here lets the explicit module References win. -->
    <PackageReference Include="UnityEngine" Version="5.6.1" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanslationStudio.Plugins.Shared\FanslationStudio.Plugins.Shared.csproj" />
    <ProjectReference Include="..\FanslationStudio.Plugins.SharpYaml\FanslationStudio.Plugins.SharpYaml.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpYaml" Version="2.1.1" />
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\FanslationStudio.Plugins\Reference\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(CI)' != 'true'">
    <Exec Command="pwsh -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\postBuildScript.ps1&quot; -TargetVer 6 -TargetDir &quot;$(TargetDir)&quot;" />
  </Target>
</Project>
